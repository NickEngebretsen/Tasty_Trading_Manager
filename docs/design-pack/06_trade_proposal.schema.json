    "account_context_id": {"type": "string"},
    "environment": {"type": "string", "enum": ["readonly", "sandbox", "paper", "shadow", "live"]},
    "strategy_version_id": {"type": ["string", "null"]},
    "market_snapshot_id": {"type": "string"},
    "thesis": {"type": "string"},
    "alternative_explanation": {"type": "string"},
    "invalidation": {"type": "string"},
    "time_horizon_days": {"type": ["integer", "null"]},
    "legs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "instrument_id": {"type": "string"},
