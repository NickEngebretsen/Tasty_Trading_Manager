    "missing_inputs": {"type": "array", "items": {"type": "string"}},
    "abstention_reason": {"type": ["string", "null"]},
    "uncertainty_description": {"type": "string"}
  },
  "required": ["action", "account_context_id", "environment", "strategy_version_id", "market_snapshot_id", "thesis", "alternative_explanation", "invalidation", "time_horizon_days", "legs", "entry_preferences", "management_policy_id", "evidence_ids", "event_exclusions", "missing_inputs", "abstention_reason", "uncertainty_description"]
